{
  "name": "roaming-pixel-cats",
  "displayName": "Roaming Pixel Cats",
  "description": "Tiny pixel-art cats that roam your whole VS Code window: they walk, nap, jump between panels, climb up and slide down.",
  "version": "0.1.47",
  "publisher": "codericsro",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikParso/vs-code-pets.git"
  },
  "bugs": {
    "url": "https://github.com/ErikParso/vs-code-pets/issues"
  },
  "homepage": "https://github.com/ErikParso/vs-code-pets#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cat",
    "pet",
    "pixel art",
    "tamagotchi",
    "fun"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pixelCat.debug",
        "title": "Pixel Cat: Toggle Debug Mode"
      },
      {
        "command": "pixelCat.remove",
        "title": "Pixel Cat: Remove from VS Code"
      },
      {
        "command": "pixelCat.install",
        "title": "Pixel Cat: Let the Cat Back In"
      }
    ],
    "configuration": {
      "title": "Pixel Cat",
      "properties": {
        "pixelCat.scale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "Size of one cat pixel, in screen pixels."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run build:inject",
    "build:inject": "tsc -p tsconfig.world.json && tsc -p tsconfig.browser.json && node scripts/bundle.js",
    "watch": "tsc -watch -p ./",
    "test": "node test/sim/smoke.js && node test/sim/trace.js",
    "sim": "node test/sim/run.js",
    "sim:compare": "node test/sim/compare.js",
    "sim:trace:record": "node test/sim/trace.js --record",
    "vscode:prepublish": "npm run compile",
    "vscode:uninstall": "node ./out/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.4.0"
  }
}
